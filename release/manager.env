# The public NBT Manager release a downloadable installer carries
# (tools/release_build.sh, .github/workflows/release.yml): its version and the
# SHA-256 from its GitHub release's SHA256SUMS. core/build.rs checks its
# signature against release/manager-public.pem (NBTFoundry/manager: release/).
# Raise both with a new manager release, then tag a new installer version.
MANAGER_VERSION=0.3.1
MANAGER_SHA256=e1c1022cfdf1cef495d4aed4c8d114c331b2ed7fcbd139bd81668a168bb9bd23
